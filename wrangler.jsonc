{
  // Cloudflare Workers 배포 설정 (npm run build → dist 폴더 + 알림 서버)
  "name": "ttiring",
  "compatibility_date": "2026-10-01",
  "main": "worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // SPA 모드는 없는 경로를 전부 index.html로 돌려보내서 /api/* 까지 가로채요.
    // 이 줄이 있어야 알림 API가 Worker로 들어옵니다. (Wrangler 4.20+)
    "run_worker_first": ["/api/*"]
  },
  // 매일 아침 알림: 15분마다 깨어나 그 시각인 사람에게만 보냅니다
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  // 푸시 서버가 연락처로 쓰는 값 (공개돼도 되는 정보예요)
  "vars": {
    "VAPID_SUBJECT": "https://ttiring.han0829.workers.dev"
  },
  // 알림 구독 보관함 (Workers KV: ttiring-subs)
  "kv_namespaces": [
    { "binding": "SUBS", "id": "efe327558b7b4791834566ba90b67442" }
  ]

  // 알림 열쇠(VAPID)는 서버가 처음 한 번 스스로 만들어 위 KV에 넣어 둡니다.
  // 그래서 따로 넣어 줄 비밀값이 없고, 열쇠는 이 계정 밖으로 나가지 않아요.
}
