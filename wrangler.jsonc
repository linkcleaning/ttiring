{
  // Cloudflare Workers 배포 설정 (npm run build → dist 폴더 + 알림 서버)
  "name": "ttiring",
  "compatibility_date": "2026-10-01",
  "main": "worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  // 매일 아침 알림: 15분마다 깨어나 그 시각인 사람에게만 보냅니다
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  "vars": {
    "VAPID_PUBLIC_KEY": "BCLoNRR3ksQ3bpAeqvhcs7jLMM76EHZCefkyvmucqH_NtiZhf7vDtj7yORCP6iumYYq7NDZ--SUA-hKGdOExT3k",
    "VAPID_SUBJECT": "mailto:han0829@gmail.com"
  },
  // 알림 구독 보관함 (Workers KV: ttiring-subs)
  "kv_namespaces": [
    { "binding": "SUBS", "id": "efe327558b7b4791834566ba90b67442" }
  ]

  // 남은 설정: Worker → Settings → Variables and Secrets 에서
  //            Secret 으로 VAPID_PRIVATE_KEY 를 추가하면 알림이 켜집니다.
  // VAPID 공개키는 공개해도 되는 값이라 위 vars에 그대로 두었습니다.
}
